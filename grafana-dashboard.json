          "query": "import \"join\"\n\ncurrent_power = from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"tapo_energy\")\n  |> filter(fn: (r) => r[\"_field\"] == \"current_power_watts\")\n  |> last()\n  |> group(columns: [\"plug_ip\"])\n  |> rename(columns: {_value: \"current_power_watts\"})\n\ntoday_energy = from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"tapo_energy\")\n  |> filter(fn: (r) => r[\"_field\"] == \"today_energy_kwh\")\n  |> last()\n  |> group(columns: [\"plug_ip\"])\n  |> rename(columns: {_value: \"today_energy_kwh\"})\n\nmonth_energy = from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"tapo_energy\")\n  |> filter(fn: (r) => r[\"_field\"] == \"month_energy_kwh\")\n  |> last()\n  |> group(columns: [\"plug_ip\"])\n  |> rename(columns: {_value: \"month_energy_kwh\"})\n\ntoday_runtime = from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"tapo_energy\")\n  |> filter(fn: (r) => r[\"_field\"] == \"today_runtime_hours\")\n  |> last()\n  |> group(columns: [\"plug_ip\"])\n  |> rename(columns: {_value: \"today_runtime_hours\"})\n\nmonth_runtime = from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"tapo_energy\")\n  |> filter(fn: (r) => r[\"_field\"] == \"month_runtime_hours\")\n  |> last()\n  |> group(columns: [\"plug_ip\"])\n  |> rename(columns: {_value: \"month_runtime_hours\"})\n\njoin.inner(\n  left: current_power,\n  right: today_energy,\n  on: (l, r) => l.plug_ip == r.plug_ip,\n  as: (l, r) => ({l with today_energy_kwh: r.today_energy_kwh})\n)\n|> join.inner(\n  right: month_energy,\n  on: (l, r) => l.plug_ip == r.plug_ip,\n  as: (l, r) => ({l with month_energy_kwh: r.month_energy_kwh})\n)\n|> join.inner(\n  right: today_runtime,\n  on: (l, r) => l.plug_ip == r.plug_ip,\n  as: (l, r) => ({l with today_runtime_hours: r.today_runtime_hours})\n)\n|> join.inner(\n  right: month_runtime,\n  on: (l, r) => l.plug_ip == r.plug_ip,\n  as: (l, r) => ({l with month_runtime_hours: r.month_runtime_hours})\n)\n|> group()\n|> keep(columns: [\"plug_ip\", \"current_power_watts\", \"today_energy_kwh\", \"month_energy_kwh\", \"today_runtime_hours\", \"month_runtime_hours\"])",
          "refId": "A"
        }
      ],
